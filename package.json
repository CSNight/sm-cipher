{
  "name": "sm-cipher",
  "version": "1.0.3",
  "description": "Dependency-free byte-oriented SM2, SM3 and SM4 TypeScript ESM library",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/smcrypto.js",
  "module": "./dist/smcrypto.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/smcrypto.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CSNight/sm-cipher"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist/smcrypto.js",
    "dist/index.d.ts",
    "dist/sm2.d.ts",
    "dist/sm3.d.ts",
    "dist/sm4.d.ts",
    "dist/types.d.ts",
    "dist/utils.d.ts",
    "src/index.ts",
    "src/sm2.ts",
    "src/sm3.ts",
    "src/sm4.ts",
    "src/utils.ts",
    "src/types.ts",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "sm2",
    "sm3",
    "sm4",
    "国密",
    "cryptography",
    "typescript",
    "cipher",
    "crypto",
    "esm"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@noble/hashes": "1.8.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "sm-crypto": "0.5.7",
    "sm-crypto-v2": "1.15.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vitest": "^4.1.8"
  },
  "prettier": {
    "singleQuote": false,
    "semi": false,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "bracketSameLine": false,
    "cursorOffset": 2
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,json,css,scss,md}": [
      "npm lint"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/test.mjs test/crossvalidation.test.mjs",
    "test:cross": "node --experimental-strip-types --test test/crossvalidation.test.mjs",
    "test:unit": "node --experimental-strip-types --test test/test.mjs",
    "test:bundle": "npm run build && node --test test/bundle.test.mjs",
    "bench": "npm run build && node test/benchmark.mjs",
    "bench:throughput": "npm run build && node test/benchmark.mjs --throughput-only",
    "bench:startup": "npm run build && node test/benchmark.mjs --startup-only",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build": "vite build && tsc -p tsconfig.json",
    "lint": "eslint . --fix",
    "prepare": "husky",
    "format": "prettier --write .",
    "commitlint": "commitlint --edit",
    "publish": "npm run build && npm publish --access public --registry=https://registry.npmjs.org/",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:bundle"
  }
}
