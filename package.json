{
  "name": "sm-cipher",
  "version": "1.0.0",
  "description": "Dependency-free byte-oriented SM2, SM3 and SM4 TypeScript ESM library",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/smcrypto.js",
  "module": "./dist/smcrypto.js",
  "types": "./dist/smcrypto.d.ts",
  "exports": {
    ".": {
      "types": "./dist/smcrypto.d.ts",
      "import": "./dist/smcrypto.js"
    }
  },
  "files": [
    "dist/smcrypto.js",
    "dist/smcrypto.d.ts",
    "dist/sm2.d.ts",
    "dist/sm3.d.ts",
    "dist/sm4.d.ts",
    "dist/types.d.ts",
    "dist/utils.d.ts",
    "smcrypto.ts",
    "sm2.ts",
    "sm3.ts",
    "sm4.ts",
    "utils.ts",
    "types.ts",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "sm2",
    "sm3",
    "sm4",
    "gmssl",
    "national-secret",
    "cryptography",
    "sm-crypto",
    "typescript",
    "esm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@noble/hashes": "1.8.0",
    "sm-crypto": "0.5.7",
    "sm-crypto-v2": "1.15.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "@types/node": "^22.20.3"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test.mjs",
    "test:bundle": "npm run build && node --test bundle.test.mjs",
    "bench": "node --experimental-strip-types benchmark.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "vite build && tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:bundle"
  }
}
