{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2020", "DOM"],
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "strict": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["vite.config.ts", "test", "node_modules", "dist"]
}
